# React frontend environment variables (place in React app root .env)

# Full API base URL including prefix, matching backend DOMAIN and API_V1_PREFIX
VITE_API_URL=/api


# WebSocket URL exposed by backend
VITE_WEBSOCKET_URL=ws://localhost/ws

# Environment indicator (optional)
VITE_ENVIRONMENT=development


